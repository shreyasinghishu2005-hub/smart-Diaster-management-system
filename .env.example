# Flask configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-32-chars

# Database URL (Default: SQLite database inside instance/ directory)
DATABASE_URL=sqlite:///instance/disaster_management.db

# File upload settings
MAX_CONTENT_LENGTH=5242880  # 5MB max upload size
UPLOAD_FOLDER=static/uploads

# Default Admin Credentials for initial setup seed
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@disaster-response.local
DEFAULT_ADMIN_PASSWORD=AdminSecure2026!
